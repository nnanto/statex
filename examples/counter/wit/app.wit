package example:counter@0.1.0;

/// A simple counter. Each key (e.g. "alice") is an independent actor.
interface counter {
  /// Adds `by` and returns the new value.
  increment: func(by: s64) -> s64;
  /// Returns the current value.
  get: func() -> s64;
  /// Resets to zero.
  reset: func();

  /// Enqueues a durable increment on another counter (or this counter).
  /// Returning an error when `fail` is true demonstrates outbox rollback.
  enqueue: func(key: string, by: s64, delay-ms: u64, fail: bool) -> result<string, string>;
  /// Inspect an outbox job belonging to this counter, as JSON.
  job: func(id: string) -> result<option<string>, string>;

  /// Schedules the alarm `delay-ms` from now. Its first `fail-times`
  /// attempts fail, to show retries.
  schedule: func(delay-ms: u64, fail-times: u32);
  /// Cancels the alarm.
  cancel: func();
  /// When the alarm is scheduled (Unix ms), if it is.
  alarm-at: func() -> option<u64>;
  /// How often the alarm has fired successfully.
  fired: func() -> s64;
  /// The alarm handler: runs when the alarm is due (not a public method).
  alarm: func(retry-count: u32) -> result<_, string>;
}

/// A tiny ledger showing records, enums, variants, options and results.
interface account {
  enum kind { deposit, withdrawal }

  record entry {
    id: u64,
    kind: kind,
    amount: u64,
    memo: option<string>,
  }

  variant tx-error {
    insufficient-funds(u64),
    invalid-amount,
  }

  deposit: func(amount: u64, memo: option<string>) -> result<u64, tx-error>;
  withdraw: func(amount: u64) -> result<u64, tx-error>;
  balance: func() -> u64;
  history: func(limit: u32) -> list<entry>;
}

world app {
  export counter;
  export account;
}
