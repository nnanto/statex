/// A tiny ledger showing records, enums, variants, options and results.
interface account {
  use statex:host/actors@0.1.0.{call-error};
  use statex:host/actors@0.1.0.{spawned-call as statex-spawned-call, delayed-call as statex-delayed-call};

  variant tx-error {
    insufficient-funds(u64),
    invalid-amount,
  }

  enum kind {
    deposit,
    withdrawal,
  }

  record entry {
    id: u64,
    kind: kind,
    amount: u64,
    memo: option<string>,
  }

  deposit: func(actor: string, amount: u64, memo: option<string>) -> result<result<u64, tx-error>, call-error>;

  withdraw: func(actor: string, amount: u64) -> result<result<u64, tx-error>, call-error>;

  balance: func(actor: string) -> result<u64, call-error>;

  history: func(actor: string, limit: u32) -> result<list<entry>, call-error>;

  statex-spawn-balance: func(actor: string) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-balance: func(actor: string, statex-delay-ms: u64) -> result<statex-delayed-call, call-error>;

  statex-spawn-deposit: func(actor: string, amount: u64, memo: option<string>) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-deposit: func(actor: string, statex-delay-ms: u64, amount: u64, memo: option<string>) -> result<statex-delayed-call, call-error>;

  statex-spawn-history: func(actor: string, limit: u32) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-history: func(actor: string, statex-delay-ms: u64, limit: u32) -> result<statex-delayed-call, call-error>;

  statex-spawn-withdraw: func(actor: string, amount: u64) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-withdraw: func(actor: string, statex-delay-ms: u64, amount: u64) -> result<statex-delayed-call, call-error>;
}

