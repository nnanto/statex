  statex-spawn-after-enqueue: func(actor: string, statex-delay-ms: u64, key: string, by: s64, delay-ms: u64, fail: bool) -> result<statex-delayed-call, call-error>;

  statex-spawn-fired: func(actor: string) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-fired: func(actor: string, statex-delay-ms: u64) -> result<statex-delayed-call, call-error>;

  statex-spawn-get: func(actor: string) -> result<statex-spawned-call, call-error>;

