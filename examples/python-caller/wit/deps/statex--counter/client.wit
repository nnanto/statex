  /// Cancels the alarm.
  cancel: func(actor: string) -> result<_, call-error>;

  /// When the alarm is scheduled (Unix ms), if it is.
  alarm-at: func(actor: string) -> result<option<u64>, call-error>;

  /// How often the alarm has fired successfully.
  fired: func(actor: string) -> result<s64, call-error>;

  statex-spawn-alarm-at: func(actor: string) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-alarm-at: func(actor: string, statex-delay-ms: u64) -> result<statex-delayed-call, call-error>;

  statex-spawn-cancel: func(actor: string) -> result<statex-spawned-call, call-error>;

  statex-spawn-after-cancel: func(actor: string, statex-delay-ms: u64) -> result<statex-delayed-call, call-error>;

