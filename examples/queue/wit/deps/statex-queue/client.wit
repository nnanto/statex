package statex:queue;

interface queue {
  use statex:host/actors@0.1.0.{call-error};

  record config {
    max-batch-size: u32,
    batch-timeout-ms: u64,
    max-retries: u32,
    retry-delay-ms: u64,
    lease-ms: u64,
    max-concurrency: u32,
    consumer-key: option<string>,
    dlq-key: option<string>,
  }

  record input {
    id: string,
    body: list<u8>,
    delay-ms: u64,
  }

  record outcome {
    id: string,
    ack: bool,
  }

  record status {
    configuration: config,
    paused: bool,
    pending: u64,
    in-flight: u64,
    active-batches: u64,
    receipts: u64,
    alarm-at: option<u64>,
  }

  configure: func(actor: string, configuration: config) -> result<result<_, string>, call-error>;

  /// False means this id was accepted previously, including already settled ids.
  send: func(actor: string, id: string, body: list<u8>, delay-ms: u64) -> result<result<bool, string>, call-error>;

  send-batch: func(actor: string, messages: list<input>) -> result<result<list<bool>, string>, call-error>;

  settle: func(actor: string, token: string, outcomes: list<outcome>) -> result<result<_, string>, call-error>;

  pause: func(actor: string) -> result<_, call-error>;

  resume: func(actor: string) -> result<_, call-error>;

  info: func(actor: string) -> result<status, call-error>;
}

interface worker {
  use statex:host/actors@0.1.0.{call-error};

  record delivery {
    id: string,
    body: list<u8>,
    attempt: u32,
  }

  process: func(actor: string, queue-key: string, token: string, messages: list<delivery>) -> result<result<_, string>, call-error>;
}

interface sink {
  use statex:host/actors@0.1.0.{call-error};

  record entry {
    id: string,
    body: list<u8>,
  }

  %record: func(actor: string, id: string, body: list<u8>) -> result<result<bool, string>, call-error>;

  entries: func(actor: string) -> result<list<entry>, call-error>;
}

world statex-calls {
  import queue;
  import worker;
  import sink;
}
