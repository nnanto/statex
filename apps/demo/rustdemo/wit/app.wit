package local:demo-rustdemo@0.1.0;

/// Each exported interface is an actor type; each function is a method.
/// Every key (e.g. "alice") is an independent actor with its own SQLite database.
interface counter {
  /// Adds `by` and returns the new value.
  increment: func(by: s64) -> s64;
  /// Returns the current value.
  get: func() -> s64;
  /// Saves the current value in the `counters` actor of app demo/db (a
  /// Python app) under this counter's key, and returns the value.
  save: func() -> result<s64, string>;
  /// The value last saved by `save`, read back from demo/db.
  saved: func() -> result<option<string>, string>;
}

world app {
  import demo:db/kv;
  export counter;
}
