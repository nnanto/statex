/// Host capabilities available to every statex actor.
package statex:host@0.1.0;

/// Identity of the actor currently executing.
interface context {
  /// Application name the component was deployed as.
  app: func() -> string;
  /// Actor type (= the exported interface name, e.g. `counter`).
  actor-type: func() -> string;
  /// Actor key (e.g. `alice`).
  key: func() -> string;
  /// Ownership epoch of this activation. Increases on every activation.
  epoch: func() -> u64;
}

/// The actor's private SQL database (SQLite by default). Every method invocation
/// runs inside one transaction managed by the host: a trap or method-level
/// result::err rolls back, a successful return commits. SQL dialect and
/// migration support belong to the configured state backend.
/// Host outbox records are reserved: guest SQL cannot read or alter their
/// tables; use actors.job for inspection.
interface sql {
  variant value {
    null,
    integer(s64),
    real(f64),
    text(string),
    blob(list<u8>),
  }

  record rows {
    columns: list<string>,
    rows: list<list<value>>,
  }

  /// Executes a statement and returns the number of changed rows.
  execute: func(stmt: string, params: list<value>) -> result<u64, string>;
  /// Runs a query and returns all rows.
  query: func(stmt: string, params: list<value>) -> result<rows, string>;
}

/// Outbound HTTP, restricted to the hosts allowed in the app's statex.toml.
/// Side effects are NOT part of the actor transaction.
interface http-client {
  record request {
    method: string,
    url: string,
    headers: list<tuple<string, string>>,
    body: option<list<u8>>,
  }

  record response {
    status: u16,
    headers: list<tuple<string, string>>,
    body: list<u8>,
  }

  send: func(req: request) -> result<response, string>;
}

/// Calls to other actors (in this app or any other deployed app).
///
/// A caller imports a generated *client interface* per callee actor type
/// (`statex calls sync`): for app `namespace/app` the package is `namespace:app`, for a
/// single-segment app `shop` it is `statex:shop`. Each callee method
/// `m(p...) -> t` is imported as `m(actor: string, p...) -> result<t, call-error>`.
/// The callee runs in its own transaction, which commits independently of the
/// caller's.
interface actors {
  /// Typed client helpers return these host-owned receipts. The runtime
  /// recognizes their type identity even when component metadata omits docs.
  record spawned-call { id: string }
  record delayed-call { id: string, delay-ms: u64 }

  variant call-error {
    /// The callee app, actor type or method does not exist.
    not-found(string),
    /// The callee rejected the arguments or returned a value that does not
    /// match the caller's client interface (the callee was redeployed with a
    /// different signature).
    incompatible(string),
    /// The callee trapped (panic, timeout, out of memory); its transaction was rolled back.
    trap(string),
    /// A host extension vetoed execution or commit; no callee transaction committed.
    rejected(string),
    /// Ownership could not be established or confirmed. The outcome of a write is unknown.
    unavailable(string),
    /// The callee is already executing further up this call chain (A -> B -> A).
    cycle(string),
    /// The caller's time budget ran out before the callee answered. The outcome is unknown.
    timeout,
  }

  /// Enqueues a durable deferred call in the caller's transaction. Arguments
  /// are a positional JSON array. Delivery is at-least-once after commit,
  /// including across restarts; use idempotent target methods. The job ID is
  /// local to the source actor. No callee runs before the caller commits.
  spawn: func(app: string, actor-type: string, key: string, method: string, args: string, delay-ms: u64) -> result<string, call-error>;
  /// Inspects a source-local job as JSON, including status, attempts, and
  /// result/error. Unknown IDs return none; terminal records remain readable.
  job: func(id: string) -> result<option<string>, string>;
}

/// The actor's alarm: at most one scheduled wake-up per actor, stored in its
/// database. When it is due, the host calls the actor type's alarm handler
/// (`alarm: func(retry-count: u32)`, exported next to its methods), activating
/// the actor if needed. Delivery is at-least-once: the handler runs in its own
/// transaction, and if it traps or returns `err` the alarm is retried with
/// backoff (`retry-count` counts the failed attempts).
///
/// Setting and clearing are part of the calling method's transaction: they
/// take effect only if it commits.
interface alarms {
  /// Schedules the alarm for `at-ms` (Unix time, milliseconds), replacing any
  /// earlier one. A time in the past fires as soon as possible. Fails if the
  /// actor type exports no alarm handler.
  set: func(at-ms: u64) -> result<_, string>;
  /// When the alarm is scheduled, if it is.
  get: func() -> option<u64>;
  /// Cancels the alarm, if any.
  clear: func();
}

interface log {
  enum level { trace, debug, info, warn, error }
  log: func(level: level, msg: string);
}

/// Everything an actor may import from the host.
world imports {
  import context;
  import sql;
  import http-client;
  import log;
  import actors;
  import alarms;
}
